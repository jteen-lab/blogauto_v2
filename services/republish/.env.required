# ========================================
# BlogAuto V2 필수 환경변수 목록
# ========================================
# 이 파일은 git으로 추적됩니다.
# 실제 값은 .env 파일에 설정하세요.
# 새 환경변수를 추가할 때 여기에도 반드시 등록하세요.
#
# 형식:
#   변수명=           → 필수 (값이 비어있으면 앱 시작 시 경고)
#   # 변수명=         → 선택 (주석은 검증 대상 아님)

# ========================================
# 애플리케이션 (필수)
# ========================================
SECRET_KEY=
ENCRYPTION_KEY=

# ========================================
# 데이터베이스 (필수)
# ========================================
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# ========================================
# JWT 인증 (필수)
# ========================================
JWT_SECRET=

# ========================================
# Blogger OAuth (Blogger 사용 시 필수)
# ========================================
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
