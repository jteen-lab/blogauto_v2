# ========================================
# BlogAuto V2 필수 환경변수 목록
# ========================================
# 이 파일은 git으로 추적됩니다.
# 실제 값은 .env 파일에 설정하세요.
# 새 환경변수를 추가할 때 여기에도 반드시 등록하세요.
#
# 형식:
#   변수명=           → 필수 (값이 비어있으면 앱 시작 시 경고)
#   # 변수명=         → 선택 (주석은 검증 대상 아님)

# ========================================
# 애플리케이션 (필수)
# ========================================
SECRET_KEY=
ENCRYPTION_KEY=

# ========================================
# 데이터베이스 (필수)
# ========================================
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# ========================================
# JWT 인증 (필수)
# ========================================
JWT_SECRET=

# ========================================
# Blogger OAuth (Blogger 사용 시 필수)
# ========================================
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=

# ========================================
# Celery 기능 플래그 (필수)
# ========================================
# true: 해당 큐로 태스크 디스패치 | false: 동기/BackgroundTask 실행
# 글 생성(프롬프트 모듈) 태스크 → celery_generation 큐
USE_CELERY_GENERATION=true
# 발행/재발행 태스크 → celery_publish 큐
USE_CELERY_PUBLISH=true
# 이미지 생성 태스크 → celery_image 큐
USE_CELERY_IMAGE=true
# 수집/데이터 등 경량 태스크 → celery_utility 큐
USE_CELERY_UTILITY=true

# ========================================
# Rate Limiter 수치 (선택, 기본값 있음)
# ========================================
# RATELIMIT_OPENAI_RPM=60
# RATELIMIT_OPENAI_TPM=90000
# RATELIMIT_ANTHROPIC_RPM=50
# RATELIMIT_ANTHROPIC_TPM=80000
# RATELIMIT_GOOGLE_RPM=60
# RATELIMIT_GOOGLE_TPM=120000
