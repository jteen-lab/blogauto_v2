# ========================================
# BlogAuto V2 필수 환경변수 목록
# ========================================
# 이 파일은 git으로 추적됩니다.
# 실제 값은 .env 파일에 설정하세요.
# 새 환경변수를 추가할 때 여기에도 반드시 등록하세요.
#
# 형식:
#   변수명=           → 필수 (값이 비어있으면 앱 시작 시 경고)
#   # 변수명=         → 선택 (주석은 검증 대상 아님)

# ========================================
# 애플리케이션 (필수)
# ========================================
SECRET_KEY=
ENCRYPTION_KEY=

# ========================================
# 데이터베이스 (필수)
# ========================================
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# ========================================
# JWT 인증 (필수)
# ========================================
JWT_SECRET=

# ========================================
# Blogger OAuth (선택 - UI 설정에서 입력 권장)
# ========================================
# UI 설정 > API 설정 > Google Blogger에서 입력하면 .env 설정 불필요
# .env에 값이 있으면 DB에 없을 때 폴백으로 사용됨
# BLOGGER_CLIENT_ID=
# BLOGGER_CLIENT_SECRET=

# ========================================
# Celery / Rate Limit (선택 - UI 시스템 설정에서 관리 권장)
# ========================================
# UI 설정 > 시스템 설정에서 관리하면 .env 설정 불필요
# .env에 값이 있으면 DB에 없을 때 폴백으로 사용됨
# USE_CELERY_GENERATION=true
# USE_CELERY_PUBLISH=true
# USE_CELERY_IMAGE=true
# USE_CELERY_UTILITY=true
# RATELIMIT_OPENAI_RPM=60
# RATELIMIT_OPENAI_TPM=90000

# ========================================
# 크롤링 한도 (선택)
# ========================================
# 블로그 1개당 한 번에 크롤링할 최대 글 수 (기본 10000).
# 수만 개 발행된 매우 큰 블로그는 더 큰 값으로 조정.
# MAX_CRAWL_POSTS=10000
