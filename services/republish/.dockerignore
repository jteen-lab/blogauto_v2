# 빌드 컨텍스트 정리 — Docker 이미지에 안 들어가야 할 것들

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 환경/로컬
.env
.env.*
!.env.required
.venv/
venv/

# 로그 (런타임에 생성됨)
logs/
*.log
*.log.*

# 로컬 데이터
*.db
*.sqlite
*.sqlite3
data/
media/
backups/
app/static/generated/

# 개발 도구
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# 테스트 산출물
.coverage
htmlcov/
.tox/

# git
.git/
.gitignore
.gitattributes

# 문서/스크립트 (빌드 불필요)
docs/
scripts/installer/
*.md
