# BlogAuto V2 Environment Configuration

# 애플리케이션 설정
APP_NAME="BlogAuto V2"
APP_VERSION="2.0.0"
ENVIRONMENT="development"  # development, testing, production
DEBUG=true

# 서버 설정
HOST="0.0.0.0"
PORT=8000
RELOAD=true

# 데이터베이스 설정 (개발환경 - SQLite)
# DATABASE_URL="sqlite+aiosqlite:///./blogauto_v2.db"

# 데이터베이스 설정 (운영환경 - PostgreSQL)
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/blogauto_v2"
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="blogauto_v2"
DB_USER="postgres"
DB_PASSWORD="password"
DB_ECHO=false

# 보안 설정 (운영환경에서는 반드시 변경!)
SECRET_KEY="your-super-secret-key-here-change-this-in-production-32chars-minimum"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=10080  # 7일 (60 * 24 * 7)
PASSWORD_HASH_ROUNDS=12

# 암호화 키 (Fernet - API 키 암호화용)
# 생성 방법: from cryptography.fernet import Fernet; Fernet.generate_key()
ENCRYPTION_KEY=""

# Redis 설정 (선택적)
REDIS_URL="redis://localhost:6379/0"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0

# 로깅 설정
LOG_LEVEL="INFO"
LOG_FILE_ENABLED=true
LOG_MAX_SIZE=10  # MB

# API 설정
API_V1_PREFIX="/api/v1"
CORS_ORIGINS='["http://localhost:3000", "http://localhost:8000"]'

# WordPress API 설정 (추후 사용)
WP_API_TIMEOUT=30
WP_MAX_RETRIES=3